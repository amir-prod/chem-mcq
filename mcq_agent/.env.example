# Chat: OpenAI-compatible API (OpenAI, Open WebUI, Ollama, vLLM, etc.)
# For Open WebUI, create a key under Settings > Account and use Bearer auth.
# Docs: https://docs.openwebui.com/features/authentication-access/api-keys
OPENAI_API_KEY=sk-your-openwebui-or-openai-key
OPENAI_MODEL=qwen36-35b
OPENAI_BASE_URL=https://horizon.ccast.ndsu.edu/api/v1
OPENAI_TEMPERATURE=0.3
# Seconds before a chat request times out (local LLMs are often slow)
OPENAI_TIMEOUT=600
OPENAI_MAX_RETRIES=2

# Embeddings: prefer a separate OpenAI key when chat points at a local server.
# If EMBEDDING_API_KEY is set, embeddings use https://api.openai.com/v1
# (explicitly — so local OPENAI_BASE_URL is not inherited by the OpenAI SDK).
EMBEDDING_API_KEY=sk-your-openai-embedding-key
# EMBEDDING_BASE_URL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# Retrieval settings
RETRIEVAL_MISCONCEPTIONS_K=8
RETRIEVAL_BEST_PRACTICES_K=5
INGESTION_CHUNK_SIZE=1200
INGESTION_CHUNK_OVERLAP=200

# Optional path overrides
# MCQ_DATA_DIR=/path/to/data
# MCQ_VECTORSTORE_DIR=/path/to/.chroma
# MCQ_OUTPUT_DIR=/path/to/outputs
# LOG_LEVEL=INFO
