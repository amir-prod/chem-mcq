# OpenAI-compatible API (required for generation and embeddings)
OPENAI_API_KEY=

# Chat model (any OpenAI-compatible model name)
OPENAI_MODEL=gpt-5.4

# Optional: custom base URL for OpenAI-compatible providers
# OPENAI_BASE_URL=https://api.openai.com/v1

# Embedding model
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# Sampling temperature (0.0–1.0)
OPENAI_TEMPERATURE=0.3

# Retrieval settings
RETRIEVAL_EXAM_K=6
RETRIEVAL_BEST_PRACTICES_K=5
INGESTION_CHUNK_SIZE=1200
INGESTION_CHUNK_OVERLAP=200

# Optional path overrides
# MCQ_DATA_DIR=/path/to/data
# MCQ_VECTORSTORE_DIR=/path/to/.chroma
# MCQ_OUTPUT_DIR=/path/to/outputs
# LOG_LEVEL=INFO
